{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/exams.schema.json",
  "title": "Exam Practice Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "exams"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "exams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "questions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "promptHtml", "options", "correctOptionIds"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "promptHtml": { "type": "string", "minLength": 1 },
                "promptText": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["single", "multi"],
                  "default": "single"
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "html", "text"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "html": { "type": "string", "minLength": 1 },
                      "text": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "correctOptionIds": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "explanationHtml": { "type": ["string", "null"] },
                "explanationText": { "type": ["string", "null"] },
                "category": { "type": ["string", "null"] },
                "difficulty": { "type": ["string", "null"] },
                "meta": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    }
  }
}

